<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="دریافت کارت با NFC"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="در گوشی مقابل صفحه ارسال باز و اشتراک‌گذاری NFC فعال باشد."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:background="@drawable/bg_gradient_card"
                android:gravity="center"
                android:text="NFC"
                android:textColor="#FFFFFF"
                android:textDirection="ltr"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/receiveStatusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="در حال آماده‌سازی"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/receiveStatusDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="وضعیت NFC در حال بررسی است."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnReceiveRetry"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_secondary_button"
                android:text="شروع مجدد دریافت"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenReceiveNfcSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_primary_button"
                android:text="روشن کردن NFC"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/receiveResultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="کارت دریافت شد"
                android:textColor="@color/success"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/receivedName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="نام مخاطب"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/receivedRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/receivedPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="@color/text_primary"
                android:textDirection="ltr"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/receivedEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_primary"
                android:textDirection="ltr"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/receivedWebsite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/primary"
                android:textDirection="ltr"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/receivedSocial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textDirection="ltr"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSaveContact"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_primary_button"
                android:text="ذخیره در مخاطبین"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReceiveAnother"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secondary_button"
                android:text="دریافت کارت دیگر"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
